# Google Gemini API key (required for cloud LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Set to false to use Gemini (cloud) instead of local Ollama
USE_LOCAL_LLM=false

# Only needed if USE_LOCAL_LLM=true
LOCAL_MODEL_NAME=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# JWT secret — change this to a strong random string in production
SECRET_KEY=change-this-to-a-strong-random-secret
